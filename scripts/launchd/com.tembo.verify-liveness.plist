  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/joel/storepulse/logs/verify-liveness.out.log</string>
  <key>StandardErrorPath</key><string>/Users/joel/storepulse/logs/verify-liveness.err.log</string>
  <key>ProcessType</key><string>Background</string>
</dict></plist>
