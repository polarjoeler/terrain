<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tembo.build-priority</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/joel/storepulse/scripts/build-priority.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/joel/storepulse/logs/build-priority.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/joel/storepulse/logs/build-priority.out.log</string>
	<!-- Rex's clock is PST: 19:30 here is 05:30 SAST (06:30 outside US daylight time), before the
	     21:00 morning digest. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>19</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/joel/storepulse</string>
</dict>
</plist>
